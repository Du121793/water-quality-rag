APP_NAME=rag-ai-helper
APP_HOST=0.0.0.0
APP_PORT=8000
APP_ENV=development
ALLOW_DEV_AUTH_BYPASS=true

# 主資料庫
DATABASE_URL=127.0.0.1
DATABASE_PORT_RW=5432
DATABASE_PORT_RO=5432
DATABASE_NAME=aqua_datahub
DATABASE_USER=aqua_migrator
DATABASE_PASSWORD=replace_with_local_secret
DATABASE_SSL=false

# AI 專用資料庫
AI_DATABASE_URL=127.0.0.1
AI_DATABASE_PORT=5433
AI_DATABASE_NAME=ai_helper_db
AI_DATABASE_USER=dev
AI_DATABASE_PASSWORD=replace_with_local_secret
AI_DATABASE_SSL=false

# 可選：直接覆蓋 DSN
# MAIN_DB_DSN=
# AI_DB_DSN=

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_KEY_PREFIX=fish-helper

WEB_JWT_SECRET=replace_with_local_secret

# Chat LLM
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_API_KEY=replace_with_local_secret
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_SECONDS=2

# Embedding
EMBEDDING_PROVIDER=ollama
EMBEDDING_BASE_URL=http://127.0.0.1:11434
EMBEDDING_API_KEY=replace_with_local_secret
EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest
EMBEDDING_DIMENSIONS=0

# Ollama Docker
OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_AUTO_PULL_MODEL=true
OLLAMA_EMBEDDING_MODEL=nomic-embed-text-v2-moe:latest

# OpenAI 範例
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=your-openai-api-key
# LLM_MODEL=gpt-4.1-mini
# EMBEDDING_PROVIDER=openai
# EMBEDDING_BASE_URL=https://api.openai.com/v1
# EMBEDDING_API_KEY=your-openai-api-key
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536

# Gemini 範例
# LLM_PROVIDER=gemini
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# LLM_API_KEY=your-gemini-api-key
# LLM_MODEL=gemini-2.5-flash
# EMBEDDING_PROVIDER=gemini
# EMBEDDING_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# EMBEDDING_API_KEY=your-gemini-api-key
# EMBEDDING_MODEL=text-embedding-004
# EMBEDDING_DIMENSIONS=768

CACHE_TTL_LATEST_SUMMARY=60
CACHE_TTL_TREND_SUMMARY=300
CACHE_TTL_RAG_RESULT=900

CHAT_HISTORY_MAX_CHARS=4000
CHAT_HISTORY_MESSAGE_LIMIT=24
CHAT_SESSION_SUMMARY_MAX_CHARS=1200

TIME_WINDOW_MAX_DAYS=31
TIME_WINDOW_MAX_POINTS=500

AUTONOMOUS_TIME_WINDOW_FETCH_ENABLED=true
AUTONOMOUS_TIME_WINDOW_MAX_ROUNDS=2
AUTONOMOUS_TIME_WINDOW_MAX_METRICS=4
